# PostgreSQL connection string. For local development, either run a local
# Postgres (e.g. `docker run -e POSTGRES_PASSWORD=postgres -p 5432:5432 postgres:16`)
# or just point this at the same free cloud database you use for deployment
# (e.g. Neon / Vercel Postgres) — see README.md for the Vercel setup.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wettportal"

# Optional: token for football-data.org, used to sync the fixture timetable
# for the top 5 European leagues automatically. Get a free token at
# https://www.football-data.org/client/register
# If left empty, fixtures can still be added manually on the /fixtures page.
FOOTBALL_DATA_API_TOKEN=
